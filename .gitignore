# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.conda/

# Secrets and local configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Jupyter
.ipynb_checkpoints/

# Tests and code quality
.pytest_cache/
pytest-cache-files-*/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# Raw and intermediate data stay local; data/processed is versioned
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep

# Reports generated by the pipeline
/reports/*
!/reports/README.md
!/reports/datasets/
/reports/datasets/repertoire_communes/vote_code_check.csv

# Models and experiment artifacts
models/
artifacts/
mlruns/
mlflow.db
outputs/
*.joblib
*.pkl
*.pickle

# Logs
*.log

# Editors
.vscode/
.idea/

# Operating systems
.DS_Store
Thumbs.db

# V1 curated snapshots only; full bundles are generated.
data/processed/modeling_v1/*
!data/processed/modeling_v1/README.md
!data/processed/modeling_v1/prepared.parquet
!data/processed/modeling_v1/strict_population.parquet
!data/processed/modeling_v1/manifest.json
!data/processed/modeling_v1/coverage.json
